# ============================================
# Mockly Environment Variables
# ============================================
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
#
# CRITICAL: Generate strong secrets with:
#   openssl rand -base64 32
# ============================================

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:3000
# NOTE: VITE_-prefixed keys are bundled into the browser!
# Only use VITE_ for non-sensitive public config.
# API keys go through the backend proxy, not here.

# --- Database ---
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/mockly

# --- Auth (REQUIRED — generate with: openssl rand -base64 32) ---
JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTES_BASE64

# --- Docker Compose ---
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_USER=postgres

# --- External APIs ---
GEMINI_API_KEY=
ELEVENLABS_PLATFORM_KEY=
DEEPSEEK_API_KEY=

# --- Judge0 (RapidAPI) ---
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# --- n8n Webhooks ---
PROMPT_SETUP_WEBHOOK_URL=http://localhost:5678/webhook/REPLACE_WITH_UUID
AGENT_SETUP_WEBHOOK_URL=http://localhost:5678/webhook/REPLACE_WITH_UUID
TECHNICAL_AGENT_WEBHOOK_URL=http://localhost:5678/webhook/REPLACE_WITH_UUID
FEEDBACK_WEBHOOK_URL=http://localhost:5678/webhook/REPLACE_WITH_UUID
TECHNICAL_FEEDBACK_WEBHOOK_URL=http://localhost:5678/webhook/REPLACE_WITH_UUID

# --- n8n Callback ---
FEEDBACK_CALLBACK_BASE_URL=http://localhost:3000
FEEDBACK_CALLBACK_SECRET=REPLACE_WITH_RANDOM_32_BYTES_BASE64

# --- MCP Server (for ElevenLabs interview agent tools) ---
MCP_SHARED_SECRET=REPLACE_WITH_RANDOM_32_BYTES_BASE64
MCP_PUBLIC_URL=

# --- Encryption ---
# AES-256-GCM key for encrypting ElevenLabs API keys at rest
# Generate: openssl rand -base64 32
# In production, use a KMS (AWS KMS / GCP Cloud KMS / Azure Key Vault) instead.
ELEVENLABS_KEY_ENC_KEY=REPLACE_WITH_RANDOM_32_BYTES_BASE64

# --- Interview Config ---
TECHNICAL_INTERVIEW_AGENT_ID=
TECHNICAL_AGENT_TEMPLATE_VERSION=1

# --- Deployment ---
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
