// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum InterviewType {
  Behavioural
  Technical
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  passwordHash            String
  name                    String?
  demoBehaviouralCredits  Int                     @default(1)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  agents                  Agent[]
  sessions                Session[]
  elevenLabsIntegration   ElevenLabsIntegration?
}

model Agent {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  configVersion   Int      @default(0)
  feedbackPrompt  String?  @db.Text
  interviewPlan   String?  @db.Text
  interviewPrompt String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  technicalQuestionId String?
  technicalQuestion   Question?    @relation(fields: [technicalQuestionId], references: [id])
  technicalQuestionSnapshot Json?
  conversationId   String?
  agentId          String?
  interviewType    InterviewType @default(Behavioural)
  feedbackPrompt   String?       @db.Text
  interviewPrompt  String?       @db.Text
  interviewPlan    String?       @db.Text
  feedback         Json?
  status           String        @default("pending")
  duration         Int?          // Duration in seconds
  score            Int?          // Normalized score 0-100
  startedAt        DateTime?     // When the interview conversation began (agent connected)
  latestCode       String?       @db.Text // Candidate's current code, synced from frontend
  latestLanguage   String?       // Language of latestCode (javascript|python|java)
  hintCount        Int           @default(0) // How many hints the agent has given
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  events           EventLog[]
}

model EventLog {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  eventType   String   // hint_given | phase_change | code_snapshot | test_run | interview_started | interview_ended
  payload     Json
  createdAt   DateTime @default(now())
}

model Question {
  id                  String    @id
  title               String
  difficulty          String
  topics              Json      @default("[]")
  pattern_tags        Json      @default("[]")
  languages_supported Json      @default("[]")
  estimated_time_min  Int
  problem_statement   String    @db.Text
  boilerplate         Json      @default("{}")
  examples            Json      @default("[]")
  constraints         Json      @default("[]")
  hidden_tests        Json      @default("[]")
  solutions           Json
  hint_framework      Json
  common_mistakes     Json      @default("[]")
  follow_ups          Json      @default("[]")
  meta                Json
  sessions            Session[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ElevenLabsIntegration {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyCiphertext Bytes
  apiKeyIv         Bytes
  apiKeyTag        Bytes
  apiKeyLast4      String
  verifiedAt       DateTime
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
