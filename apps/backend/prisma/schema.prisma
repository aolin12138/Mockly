// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum InterviewType {
  Behavioural
  Technical
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  passwordHash            String
  name                    String?
  demoBehaviouralCredits  Int                     @default(1)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  agents                  Agent[]
  sessions                Session[]
  elevenLabsIntegration   ElevenLabsIntegration?
}

model ElevenLabsIntegration {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyCiphertext Bytes
  apiKeyIv         Bytes
  apiKeyTag        Bytes
  apiKeyLast4      String
  verifiedAt       DateTime
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Agent {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  feedbackPrompt  String?  @db.Text
  interviewPlan   String?  @db.Text
  interviewPrompt String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  agentId          String?
  interviewType    InterviewType @default(Behavioural)
  feedbackPrompt   String?       @db.Text
  interviewPrompt  String?       @db.Text
  interviewPlan    String?       @db.Text
  feedback         Json?
  status           String        @default("pending")
  duration         Int?          // Duration in seconds
  score            Int?          // Normalized score 0-100
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Question {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  difficulty        String   @default("medium") // easy, medium, hard
  skillTargets      Json     @default("[]") // JSON array of strings
  tags              Json     @default("[]") // JSON array of strings
  problemStatement  String   @db.Text
  constraints       Json     @default("[]") // JSON array of strings
  boilerplate       Json     // JSON object keyed by language: { javascript: "...", python: "...", java: "..." }
  visibleTests      Json     // JSON array of { id, input, expected }
  hiddenTests       Json     // JSON array of { id, input, expected, tags }
  failureModes      Json     @default("[]") // JSON array of strings
  hints             Json     @default("[]") // JSON array of strings
  interviewerProbes Json     @default("[]") // JSON array of strings
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

