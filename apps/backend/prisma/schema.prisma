// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agents       Agent[]
  sessions     Session[]
}

model Agent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  agentId          String?
  feedbackPrompt   String?  @db.Text
  interviewPrompt  String?  @db.Text
  interviewPlan    String?  @db.Text
  feedback         Json?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Question {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  difficulty        String   @default("medium") // easy, medium, hard
  skillTargets      Json     @default("[]") // JSON array of strings
  tags              Json     @default("[]") // JSON array of strings
  problemStatement  String   @db.Text
  constraints       Json     @default("[]") // JSON array of strings
  boilerplate       Json     // JSON object keyed by language: { javascript: "...", python: "...", java: "..." }
  visibleTests      Json     // JSON array of { id, input, expected }
  hiddenTests       Json     // JSON array of { id, input, expected, tags }
  failureModes      Json     @default("[]") // JSON array of strings
  hints             Json     @default("[]") // JSON array of strings
  interviewerProbes Json     @default("[]") // JSON array of strings
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

